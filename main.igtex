\section{tests of features}
\subsection{medias}

\begin{frame}{Video, with a size=1}
\video{myvideo.mkv}[size=1]
\end{frame}


\begin{frame}{images}{with no arguments}
\image{mygif.gif}
\end{frame}

\begin{frame}{images}{with a size=2, right-top, with a subtitle}
\image{mygif.gif}[position=right-top, size=2]
\end{frame}

\begin{frame}{imageswith a size=2, left-bottom, with no subtitle}
\image{mygif.gif}[position=left-bottom, size=2]
\end{frame}

\begin{frame}{imageswith a size=2, right-bottom}
\image{mygif.gif}[position=right-bottom, size=2]
\end{frame}




